{
  "expo": {
    "name": "ichigo-ichie",
    "slug": "ichigo-ichie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kishiryusei.ichigoichie",
      "infoPlist": {
        "NSCameraUsageDescription": "写真を撮影して思い出を保存します。",
        "NSLocationWhenInUseUsageDescription": "現在地を取得して近くの思い出を表示します。",
        "NSPhotoLibraryAddUsageDescription": "撮影した写真をカメラロールに保存します。",
        "NSPhotoLibraryUsageDescription": "カメラロールから写真を選択します。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-camera",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "現在地を取得して近くの思い出を表示します。"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "撮影した写真をカメラロールに保存します。",
          "savePhotosPermission": "撮影した写真をカメラロールに保存します。",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "48687571-9707-4918-94f2-8595ade1d0c1"
      }
    },
    "owner": "kicg"
  }
}
